<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_launcher"
        app:tint="@color/neon_cyan" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone Monitor"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="30dp"
        android:text="جاري التحقق من الصلاحيات..."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- زر طلب الإذن -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPermission"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="منح إذن الظهور فوق التطبيقات"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/neon_orange"
        app:cornerRadius="12dp" />

    <!-- زر تشغيل الخدمة -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleService"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="تشغيل النافذة العائمة"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/neon_cyan"
        app:cornerRadius="12dp" />

    <!-- زر تخصيص المؤشرات -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="إعدادات وتخصيص المؤشرات"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:backgroundTint="@color/card_dark"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp"
        app:cornerRadius="12dp" />

</LinearLayout>
